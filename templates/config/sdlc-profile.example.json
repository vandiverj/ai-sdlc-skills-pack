{
  "schemaVersion": "sdlc-profile-v1",
  "repository": {
    "name": "example-service",
    "kind": "api"
  },
  "context": {
    "sharedRoot": "",
    "product": "",
    "repo": "",
    "output": ".ai-local/sdlc-runs"
  },
  "commands": [
    {
      "kind": "test",
      "command": "npm run test"
    }
  ],
  "capabilities": {
    "ticketMcp": "unknown",
    "databaseMcp": "unknown",
    "browser": "unknown"
  },
  "units": [
    {
      "id": "api",
      "root": ".",
      "kind": "api",
      "testSurface": "api-contract",
      "contextBucket": "api"
    }
  ],
  "validationTarget": {
    "type": "current-repo",
    "path": ".",
    "approval": "external targets require developer approval",
    "unavailableBehavior": "record evidence gap and use repo-local dry-run packet",
    "allowedCommands": [
      "sdlc scenario test --repo .",
      "sdlc fixture plan --task \"<task>\" --repo ."
    ],
    "notes": "Default validation starts with current repository deterministic checks and dry-run packets. Configure a disposable fixture repo in .ai-local only when the developer approves it."
  },
  "policy": {
    "release": "human controlled",
    "approvalGates": "commit,push",
    "sensitiveData": "redact product/client data"
  }
}
