{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLC Repository Profile",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "units"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sdlc-profile-v1"
    },
    "repository": {
      "type": "object"
    },
    "context": {
      "type": "object"
    },
    "commands": {
      "type": "array"
    },
    "capabilities": {
      "type": "object"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "root"
        ]
      }
    },
    "validationTarget": {
      "type": "object",
      "description": "Optional local target for SDLC fixture or dry-run validation. Current repository deterministic checks remain the default when this is omitted.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "current-repo",
            "dry-run-only",
            "fixture-repo",
            "workspace-repo"
          ]
        },
        "path": {
          "type": "string"
        },
        "approval": {
          "type": "string"
        },
        "unavailableBehavior": {
          "type": "string"
        },
        "allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object"
    }
  }
}
