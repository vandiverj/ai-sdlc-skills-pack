{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLC Knowledge Candidate",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "class",
    "claim",
    "sourceArtifacts",
    "anchors",
    "taskRunEvidence",
    "appliesTo",
    "confidence",
    "confidenceLastConfirmed",
    "decayPolicy",
    "driftStatus",
    "sensitivity",
    "ownerArtifact",
    "suggestedAction"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "sourceArtifacts": {
      "type": "array"
    },
    "anchors": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
