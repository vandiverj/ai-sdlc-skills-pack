{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airtera.local/schemas/sdlc-read-only-code-scout-request.schema.json",
  "title": "SDLC Read-Only Code Scout Request",
  "type": "object",
  "required": [
    "schemaVersion",
    "agentRole",
    "languageProfile",
    "taskType",
    "taskSummary",
    "scope",
    "allowedActions",
    "forbiddenActions",
    "evidenceRequired",
    "outputSchema",
    "escalationTriggers",
    "modelTierPreference",
    "fallbackInstruction"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sdlc.read_only_code_scout.request.v1"
    },
    "agentRole": {
      "const": "read-only-code-scout"
    },
    "languageProfile": {
      "enum": [
        "generic",
        "classic-asp",
        "dotnet-csharp",
        "typescript-react",
        "sql",
        "node",
        "python"
      ]
    },
    "taskType": {
      "enum": [
        "duplication-scan",
        "abandoned-code-scan",
        "extraction-candidate-scan",
        "test-gap-scan",
        "risk-surface-scan",
        "context-summary"
      ]
    },
    "taskSummary": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedActions": {
      "type": "array",
      "contains": {
        "const": "read"
      }
    },
    "forbiddenActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceRequired": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputSchema": {
      "type": "object"
    },
    "escalationTriggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modelTierPreference": {
      "type": "string"
    },
    "fallbackInstruction": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
